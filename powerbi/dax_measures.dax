// =============================================================================
//  Business Operations & Customer Support Analytics — DAX measure library
// -----------------------------------------------------------------------------
//  HOW TO USE
//  Power BI Desktop → DAX query view → paste this file → Run.
//  The DEFINE block creates every measure in the '_Measures' table
//  ("Update model with changes" button), and the EVALUATE at the bottom returns
//  the headline KPIs so you can compare them with
//  powerbi/validation/expected_kpi_values.csv (generated by Python/SQL).
//
//  MODEL ASSUMPTIONS (see powerbi/data_model.md)
//  * DimDate[Date] → FactSupportTickets[created_date]          (active)
//    DimDate[Date] → FactSupportTickets[resolved_date_only]    (INACTIVE, used via USERELATIONSHIP)
//    DimDate[Date] → FactCustomerFeedback[feedback_date_only]  (active)
//    DimDate[Date] → FactOperations[operation_date] / FactBusinessCosts[cost_date] /
//                    FactAgentPerformance[performance_date]      (active)
//  * Boolean flags are stored as 0/1 integers, so SUM() counts them.
//  * Denominators follow docs/KPI_definitions.md:
//      - SLA, FCR, avg resolution  → sla_eligible tickets only (Closed/Resolved with a valid timestamp)
//      - Resolution / escalation rate → all non-cancelled tickets
//      - CSAT → surveys with a valid 1-5 score (blank scores are never treated as 0)
//
//  Each measure is preceded by: WHAT it measures · WHY (business purpose) ·
//  AGGREGATION · DATE behaviour.
// =============================================================================

DEFINE

// ============================== TICKET VOLUME ===============================

    // WHAT  Number of tickets created.
    // WHY   Demand signal; base for every rate.
    // AGG   COUNTROWS over the ticket fact (one row per ticket, no duplicates).
    // DATE  Filtered by ticket creation date (active relationship).
    MEASURE '_Measures'[Total Tickets] = COUNTROWS ( FactSupportTickets )

    // WHAT  Tickets currently Open, In Progress or Pending (backlog).
    // WHY   Work-in-progress the team still owes customers.
    // AGG   SUM of 0/1 flag is_unresolved.
    // DATE  Counts unresolved tickets *created* in the selected period (state at snapshot 31-Dec-2025).
    MEASURE '_Measures'[Open Tickets] = SUM ( FactSupportTickets[is_unresolved] )

    // WHAT  Tickets with status Closed or Resolved.
    // WHY   Completed demand.
    // AGG   SUM of is_resolved flag.
    // DATE  By creation date.
    MEASURE '_Measures'[Closed Tickets] = SUM ( FactSupportTickets[is_resolved] )

    // WHAT  Alias of Closed Tickets used on cards titled "Resolved".
    MEASURE '_Measures'[Resolved Tickets] = [Closed Tickets]

    // WHAT  Tickets waiting on the customer (status = Pending).
    // WHY   Separates customer-side waiting from team-side backlog.
    // AGG   COUNTROWS with status filter.
    // DATE  By creation date.
    MEASURE '_Measures'[Pending Tickets] =
        CALCULATE ( COUNTROWS ( FactSupportTickets ), FactSupportTickets[ticket_status] = "Pending" )

    // WHAT  Cancelled tickets (excluded from SLA/FCR/resolution-rate denominators).
    MEASURE '_Measures'[Cancelled Tickets] = SUM ( FactSupportTickets[is_cancelled] )

    // WHAT  Non-cancelled tickets — denominator for resolution and escalation rates.
    MEASURE '_Measures'[Actionable Tickets] = [Total Tickets] - [Cancelled Tickets]

    // WHAT  Tickets escalated at least once.
    // WHY   Escalations consume senior capacity and signal front-line capability gaps.
    // AGG   SUM of escalation_flag.
    // DATE  By creation date.
    MEASURE '_Measures'[Escalated Tickets] = SUM ( FactSupportTickets[escalation_flag] )

    // WHAT  Tickets reopened at least once.
    // WHY   Quality signal — the first fix did not hold.
    // AGG   SUM of is_reopened flag (ticket counted once even if reopened several times).
    // DATE  By creation date.
    MEASURE '_Measures'[Reopened Tickets] = SUM ( FactSupportTickets[is_reopened] )

    // WHAT  Backlog (same as Open Tickets); kept separate for page-6 naming.
    MEASURE '_Measures'[Ticket Backlog] = [Open Tickets]

    // WHAT  Open tickets older than 7 days at the snapshot.
    // WHY   Aged work is almost certainly breaching SLA.
    // AGG   COUNTROWS with filters on flag and age.
    // DATE  By creation date.
    MEASURE '_Measures'[Aging Ticket Backlog] =
        CALCULATE (
            COUNTROWS ( FactSupportTickets ),
            FactSupportTickets[is_unresolved] = 1,
            FactSupportTickets[ticket_age_days] > 7
        )

// ============================ RESPONSE & RESOLUTION =========================

    // WHAT  Mean hours from creation to first response.
    // WHY   Speed of acknowledgement — strongly associated with CSAT.
    // AGG   AVERAGE ignores blanks → only tickets that have a first response.
    // DATE  By creation date.
    MEASURE '_Measures'[Avg First Response Time (h)] = AVERAGE ( FactSupportTickets[first_response_hours] )

    // WHAT  Median first response hours (robust to the long tail of async channels).
    MEASURE '_Measures'[Median First Response Time (h)] = MEDIAN ( FactSupportTickets[first_response_hours] )

    // WHAT  Mean hours from creation to resolution, resolved tickets only.
    // WHY   Core efficiency KPI.
    // AGG   AVERAGE restricted to sla_eligible rows (open tickets have no resolution time and are not averaged as 0).
    // DATE  By creation date (cohort view). See [Avg Resolution Time by Resolved Date (h)] for the throughput view.
    MEASURE '_Measures'[Avg Resolution Time (h)] =
        CALCULATE ( AVERAGE ( FactSupportTickets[resolution_hours] ), FactSupportTickets[sla_eligible] = 1 )

    // WHAT  Median resolution hours for resolved tickets.
    MEASURE '_Measures'[Median Resolution Time (h)] =
        CALCULATE ( MEDIAN ( FactSupportTickets[resolution_hours] ), FactSupportTickets[sla_eligible] = 1 )

    // WHAT  Avg resolution hours attributed to the month the ticket was RESOLVED.
    // WHY   Throughput view for operational reviews ("what did we close this month?").
    // AGG   AVERAGE with the inactive resolved-date relationship activated.
    // DATE  By resolution date.
    MEASURE '_Measures'[Avg Resolution Time by Resolved Date (h)] =
        CALCULATE (
            AVERAGE ( FactSupportTickets[resolution_hours] ),
            FactSupportTickets[sla_eligible] = 1,
            USERELATIONSHIP ( DimDate[Date], FactSupportTickets[resolved_date_only] )
        )

    // WHAT  Tickets resolved in the selected period (by resolution date).
    MEASURE '_Measures'[Tickets Resolved in Period] =
        CALCULATE ( SUM ( FactSupportTickets[is_resolved] ),
                    USERELATIONSHIP ( DimDate[Date], FactSupportTickets[resolved_date_only] ) )

// ================================ SLA & FCR =================================

    // WHAT  Resolved tickets eligible for SLA measurement (denominator).
    MEASURE '_Measures'[SLA Eligible Tickets] = SUM ( FactSupportTickets[sla_eligible] )

    // WHAT  Eligible tickets resolved within their SLA target.
    MEASURE '_Measures'[SLA Compliant Tickets] =
        CALCULATE ( COUNTROWS ( FactSupportTickets ), FactSupportTickets[sla_met] = 1 )

    // WHAT  Eligible tickets resolved after their SLA target.
    MEASURE '_Measures'[SLA Breached Tickets] =
        CALCULATE ( COUNTROWS ( FactSupportTickets ), FactSupportTickets[sla_met] = 0 )

    // WHAT  % of eligible resolved tickets resolved within SLA.
    // WHY   Primary service-level KPI.
    // AGG   Ratio of counts (never an average of per-group percentages).
    // DATE  By creation date.
    MEASURE '_Measures'[SLA Compliance Rate] = DIVIDE ( [SLA Compliant Tickets], [SLA Eligible Tickets] )

    // WHAT  % of eligible resolved tickets that breached SLA ( = 1 − compliance ).
    MEASURE '_Measures'[SLA Breach Rate] = DIVIDE ( [SLA Breached Tickets], [SLA Eligible Tickets] )

    // WHAT  Open tickets already older than their SLA target (forward-looking exposure).
    // WHY   Unresolved tickets are NOT in the SLA rate; this measure tracks them separately.
    MEASURE '_Measures'[Open Tickets Past SLA] =
        SUMX (
            FILTER ( FactSupportTickets, FactSupportTickets[is_unresolved] = 1 ),
            IF ( FactSupportTickets[ticket_age_days] * 24 > FactSupportTickets[sla_target_hours], 1, 0 )
        )

    // WHAT  % of eligible resolved tickets solved on first contact (not reopened, not escalated).
    // WHY   Efficiency + experience lever; FCR tickets score ~0.9 CSAT points higher.
    // AGG   Ratio of flag sums.
    // DATE  By creation date.
    MEASURE '_Measures'[First Contact Resolution Rate] =
        DIVIDE ( SUM ( FactSupportTickets[is_fcr] ), [SLA Eligible Tickets] )

    // WHAT  % of non-cancelled tickets that are resolved.
    // WHY   Completion rate — differs from SLA (speed) and FCR (first-touch quality).
    MEASURE '_Measures'[Ticket Resolution Rate] = DIVIDE ( [Closed Tickets], [Actionable Tickets] )

    // WHAT  % of non-cancelled tickets escalated.
    MEASURE '_Measures'[Escalation Rate] = DIVIDE ( [Escalated Tickets], [Actionable Tickets] )

    // WHAT  % of resolved tickets reopened.
    MEASURE '_Measures'[Reopen Rate] = DIVIDE ( [Reopened Tickets], [Closed Tickets] )

// ============================ CUSTOMER EXPERIENCE ===========================

    // WHAT  Mean satisfaction score (1-5).
    // WHY   Headline customer-experience KPI.
    // AGG   AVERAGE ignores blank (missing/invalid) scores.
    // DATE  By FEEDBACK date (active relationship on the feedback fact).
    MEASURE '_Measures'[Avg Customer Satisfaction] = AVERAGE ( FactCustomerFeedback[satisfaction_score] )

    // WHAT  Surveys with a valid score.
    MEASURE '_Measures'[Survey Responses] = COUNT ( FactCustomerFeedback[satisfaction_score] )

    // WHAT  % of valid surveys scoring 4 or 5.
    // WHY   Easier to communicate than an average; robust to scale skew.
    MEASURE '_Measures'[Customer Satisfaction Rate] =
        DIVIDE (
            CALCULATE ( COUNT ( FactCustomerFeedback[satisfaction_score] ), FactCustomerFeedback[satisfaction_score] >= 4 ),
            [Survey Responses]
        )

    // WHAT  Change in average CSAT vs the previous month.
    // WHY   Trend card on page 3.
    // DATE  Requires a month (or finer) context on DimDate.
    MEASURE '_Measures'[Customer Satisfaction Change] =
        VAR Curr = [Avg Customer Satisfaction]
        VAR Prev = CALCULATE ( [Avg Customer Satisfaction], DATEADD ( DimDate[Date], -1, MONTH ) )
        RETURN IF ( NOT ISBLANK ( Curr ) && NOT ISBLANK ( Prev ), Curr - Prev )

    // WHAT  % of tickets raised within 7 days of the same customer's previous ticket.
    // WHY   Repeat contact = unresolved underlying problem.
    // AGG   Ratio of flag sum to tickets.
    MEASURE '_Measures'[Repeat Contact Rate] =
        DIVIDE ( SUM ( FactSupportTickets[is_repeat_contact] ), [Total Tickets] )

    // WHAT  Distinct customers who raised at least one ticket in the filter context.
    MEASURE '_Measures'[Contacting Customers] = DISTINCTCOUNT ( FactSupportTickets[customer_id] )

    // WHAT  Customers in the customer dimension (respects customer slicers only).
    MEASURE '_Measures'[Total Customers] = COUNTROWS ( DimCustomer )

// ============================== AGENT PERFORMANCE ===========================

    // WHAT  Agents with at least one assigned ticket in context.
    // WHY   Denominator for per-agent productivity.
    MEASURE '_Measures'[Total Agents] =
        CALCULATE ( DISTINCTCOUNT ( FactSupportTickets[agent_id] ), NOT ISBLANK ( FactSupportTickets[agent_id] ) )

    // WHAT  Tickets with a known agent.
    MEASURE '_Measures'[Tickets Assigned] =
        CALCULATE ( COUNTROWS ( FactSupportTickets ), NOT ISBLANK ( FactSupportTickets[agent_id] ) )

    // WHAT  Resolved tickets with a known agent.
    MEASURE '_Measures'[Tickets Resolved] =
        CALCULATE ( [Closed Tickets], NOT ISBLANK ( FactSupportTickets[agent_id] ) )

    // WHAT  Average tickets assigned per agent.
    // AGG   Ratio — not an average of per-agent counts across a matrix.
    MEASURE '_Measures'[Average Tickets per Agent] = DIVIDE ( [Tickets Assigned], [Total Agents] )

    // WHAT  Tickets per Agent (alias used by KPI cards).
    MEASURE '_Measures'[Tickets per Agent] = [Average Tickets per Agent]

    // WHAT  Resolved / assigned non-cancelled tickets, known agents only.
    // WHY   Completion efficiency at agent level.
    MEASURE '_Measures'[Agent Productivity Rate] =
        DIVIDE (
            [Tickets Resolved],
            CALCULATE ( [Actionable Tickets], NOT ISBLANK ( FactSupportTickets[agent_id] ) )
        )

    // WHAT  Logged workload hours × 60 / tickets resolved (agent performance fact).
    // WHY   Average handling time incl. admin time share.
    // DATE  By performance month.
    MEASURE '_Measures'[Average Handling Time (min)] =
        DIVIDE ( SUM ( FactAgentPerformance[workload_hours] ) * 60, SUM ( FactAgentPerformance[tickets_resolved] ) )

    // WHAT  Total logged workload hours.
    MEASURE '_Measures'[Workload Hours] = SUM ( FactAgentPerformance[workload_hours] )

    // WHAT  SLA compliance for tickets handled by known agents (same definition as [SLA Compliance Rate]).
    MEASURE '_Measures'[Agent SLA Compliance] =
        CALCULATE ( [SLA Compliance Rate], NOT ISBLANK ( FactSupportTickets[agent_id] ) )

    // WHAT  Average CSAT for surveys linked to a known agent.
    MEASURE '_Measures'[Average Agent Satisfaction Score] =
        CALCULATE ( [Avg Customer Satisfaction], NOT ISBLANK ( FactCustomerFeedback[agent_id] ) )

    // WHAT  Rank of the agent by tickets resolved (1 = most).
    // WHY   Agent Productivity Ranking visual.
    MEASURE '_Measures'[Agent Productivity Rank] =
        IF (
            HASONEVALUE ( DimAgent[agent_id] ),
            RANKX ( ALLSELECTED ( DimAgent ), [Tickets Resolved], , DESC, DENSE )
        )

// ============================ BUSINESS OPERATIONS ===========================

    // WHAT  Total transactions processed.
    // AGG   SUM. DATE  By operation date.
    MEASURE '_Measures'[Total Transactions] = SUM ( FactOperations[total_transactions] )

    // WHAT  Successful transactions.
    MEASURE '_Measures'[Successful Transactions] = SUM ( FactOperations[successful_transactions] )

    // WHAT  Failed transactions.
    MEASURE '_Measures'[Failed Transactions] = SUM ( FactOperations[failed_transactions] )

    // WHAT  Successful / total transactions.
    // AGG   Ratio of sums (NOT the average of daily success rates).
    MEASURE '_Measures'[Operational Success Rate] = DIVIDE ( [Successful Transactions], [Total Transactions] )

    // WHAT  Failed / total transactions.
    MEASURE '_Measures'[Operational Failure Rate] = DIVIDE ( [Failed Transactions], [Total Transactions] )

    // WHAT  Transaction-weighted average processing minutes.
    // WHY   A plain AVERAGE of daily averages over-weights quiet days.
    MEASURE '_Measures'[Average Processing Time (min)] =
        DIVIDE (
            SUMX ( FactOperations, FactOperations[processing_time_minutes] * FactOperations[total_transactions] ),
            [Total Transactions]
        )

    // WHAT  Total variable transaction-processing cost.
    MEASURE '_Measures'[Total Operational Cost] = SUM ( FactOperations[operational_cost] )

    // WHAT  Operational cost / transactions.
    MEASURE '_Measures'[Average Cost per Transaction] = DIVIDE ( [Total Operational Cost], [Total Transactions] )

    // WHAT  Successful transactions per $1,000 of operational cost.
    // WHY   Efficiency index that rises with quality AND cost discipline.
    MEASURE '_Measures'[Operational Efficiency Rate] =
        DIVIDE ( [Successful Transactions], [Total Operational Cost] ) * 1000

    // WHAT  Departmental staffing & overhead cost (business costs fact).
    // DATE  By cost month.
    MEASURE '_Measures'[Departmental Cost] = SUM ( FactBusinessCosts[total_cost] )

    // WHAT  Direct / indirect split of departmental cost.
    MEASURE '_Measures'[Direct Cost] = SUM ( FactBusinessCosts[direct_cost] )
    MEASURE '_Measures'[Indirect Cost] = SUM ( FactBusinessCosts[indirect_cost] )

    // WHAT  Departmental cost / resolved tickets in the same filter context.
    // WHY   Fully loaded unit cost of support.
    MEASURE '_Measures'[Cost per Resolved Ticket] = DIVIDE ( [Departmental Cost], [Closed Tickets] )

    // WHAT  Spend as % of pro-rated annual budget for the months in context.
    MEASURE '_Measures'[Budget Utilisation] =
        VAR Months = DISTINCTCOUNT ( FactBusinessCosts[cost_date] )
        VAR Budget = SUMX ( VALUES ( DimDepartment[department_id] ),
                            CALCULATE ( MAX ( DimDepartment[operational_budget] ) ) ) / 12 * Months
        RETURN DIVIDE ( [Departmental Cost], Budget )

    // WHAT  Number of departments in context.
    MEASURE '_Measures'[Total Departments] = COUNTROWS ( DimDepartment )

// ============================== TIME INTELLIGENCE ===========================
//  DimDate must be marked as a date table. Results are BLANK at year/total level
//  where "previous month" is undefined.

    MEASURE '_Measures'[Previous Month Tickets] =
        CALCULATE ( [Total Tickets], DATEADD ( DimDate[Date], -1, MONTH ) )

    MEASURE '_Measures'[Month-over-Month Ticket Growth] =
        DIVIDE ( [Total Tickets] - [Previous Month Tickets], [Previous Month Tickets] )

    MEASURE '_Measures'[Previous Year Tickets] =
        CALCULATE ( [Total Tickets], SAMEPERIODLASTYEAR ( DimDate[Date] ) )

    MEASURE '_Measures'[Year-over-Year Ticket Growth] =
        DIVIDE ( [Total Tickets] - [Previous Year Tickets], [Previous Year Tickets] )

    MEASURE '_Measures'[Previous Month Operational Cost] =
        CALCULATE ( [Total Operational Cost], DATEADD ( DimDate[Date], -1, MONTH ) )

    MEASURE '_Measures'[Previous Month SLA Compliance] =
        CALCULATE ( [SLA Compliance Rate], DATEADD ( DimDate[Date], -1, MONTH ) )

    MEASURE '_Measures'[SLA Compliance Change (pp)] =
        VAR c = [SLA Compliance Rate]
        VAR p = [Previous Month SLA Compliance]
        RETURN IF ( NOT ISBLANK ( c ) && NOT ISBLANK ( p ), ( c - p ) * 100 )

    MEASURE '_Measures'[Tickets YTD] = TOTALYTD ( [Total Tickets], DimDate[Date] )

    // Monthly average over the 3 months ending at the last date in context
    // (use on a month axis).
    MEASURE '_Measures'[Tickets 3M Moving Avg] =
        VAR LastDate = MAX ( DimDate[Date] )
        RETURN DIVIDE ( CALCULATE ( [Total Tickets], DATESINPERIOD ( DimDate[Date], LastDate, -3, MONTH ) ), 3 )

// =========================== UI HELPER MEASURES =============================

    // Dynamic title text for the selected period (used in page headers).
    MEASURE '_Measures'[Selected Period Label] =
        VAR mn = MIN ( DimDate[Date] )
        VAR mx = MAX ( DimDate[Date] )
        RETURN FORMAT ( mn, "mmm yyyy" ) & " – " & FORMAT ( mx, "mmm yyyy" )

    // Conditional-formatting colour for SLA cards (theme status colours).
    MEASURE '_Measures'[SLA Status Colour] =
        SWITCH ( TRUE (),
                 [SLA Compliance Rate] >= 0.85, "#0ca30c",
                 [SLA Compliance Rate] >= 0.70, "#fab219",
                 "#d03b3b" )

EVALUATE
    ROW (
        "Total Tickets",                 [Total Tickets],
        "Open Tickets",                  [Open Tickets],
        "Closed Tickets",                [Closed Tickets],
        "Avg First Response Time (h)",   [Avg First Response Time (h)],
        "Avg Resolution Time (h)",       [Avg Resolution Time (h)],
        "SLA Compliance Rate",           [SLA Compliance Rate],
        "First Contact Resolution Rate", [First Contact Resolution Rate],
        "Avg Customer Satisfaction",     [Avg Customer Satisfaction],
        "Customer Satisfaction Rate",    [Customer Satisfaction Rate],
        "Operational Success Rate",      [Operational Success Rate],
        "Total Operational Cost",        [Total Operational Cost],
        "Cost per Resolved Ticket",      [Cost per Resolved Ticket]
    )
